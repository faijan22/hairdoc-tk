DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://hairdoctk:hairdoctk_local@127.0.0.1:5433/hairdoctk
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS_CHANNEL_LAYER=true
CORS_ALLOWED_ORIGINS=http://localhost:8081
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_ACTION_TOKEN_MINUTES=30
AUTH_JWT_ISSUER=hairdoc-tk-api
AUTH_JWT_AUDIENCE=hairdoc-tk-app
AUTH_APP_URL=hairdoctk://
PAYMENT_PROVIDER_BACKEND=apps.payments.providers.square.SquarePaymentProvider
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-08-19
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
PAYMENT_RETURN_BASE_URL=http://127.0.0.1:8000/api/v1/payments/return
VIDEO_PROVIDER_BACKEND=apps.video.providers.disabled.DisabledVideoProvider
VIDEO_JOIN_EARLY_MINUTES=10
VIDEO_JOIN_LATE_MINUTES=15
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=https://your-domain.daily.co
PUSH_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
DEFAULT_FROM_EMAIL=HairDoc TK <noreply@example.com>
PHOTO_CONSENT_REQUIRED=true
