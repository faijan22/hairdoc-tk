# Public staging origin
HAIRDOC_DOMAIN=hairdoctk-dev.livecoder.tech
HAIRDOC_API_PORT=18010

# Internal database credentials (generate a long random password)
POSTGRES_DB=hairdoctk_staging
POSTGRES_USER=hairdoctk_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Django
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=hairdoctk-dev.livecoder.tech,api,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://hairdoctk-dev.livecoder.tech
CORS_ALLOWED_ORIGINS=http://localhost:8081
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_ACTION_TOKEN_MINUTES=30
AUTH_JWT_ISSUER=hairdoc-tk-staging-api
AUTH_JWT_AUDIENCE=hairdoc-tk-app
AUTH_APP_URL=hairdoctk://

# Stripe test mode only on staging
PAYMENT_PROVIDER_BACKEND=apps.payments.providers.stripe.StripePaymentProvider
STRIPE_ENVIRONMENT=test
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RETURN_BASE_URL=https://hairdoctk-dev.livecoder.tech/api/v1/payments/return

# Phase 1 photo-first care; managed video remains disabled
VIDEO_PROVIDER_BACKEND=apps.video.providers.disabled.DisabledVideoProvider
VIDEO_JOIN_EARLY_MINUTES=10
VIDEO_JOIN_LATE_MINUTES=15
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=

# Enable only after the relevant external credentials/build are ready
PUSH_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=HairDoc TK <noreply@hairdoctk.com>

# Staging must exercise the same legal gate as production
PHOTO_CONSENT_REQUIRED=true

