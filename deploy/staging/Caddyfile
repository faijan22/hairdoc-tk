{
  email {$ACME_EMAIL}
  admin off
}

{$HAIRDOC_DOMAIN} {
  encode zstd gzip

  @static path /static/*
  handle @static {
    root * /srv
    file_server
  }

  reverse_proxy api:8000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  log {
    output stdout
    format json
  }
}

